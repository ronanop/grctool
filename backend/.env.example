# ISO 27001 Compliance Portal - Backend environment variables
# Copy this file to .env and fill in values. Never commit .env.

# --- Required ---
# MongoDB: local or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/iso27001_compliance
# JWT: use a strong random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production

# --- Optional: Auth ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Optional: Paths (use absolute paths in production) ---
# Directory for uploaded files (policies, proofs, RAG/local VD PDFs)
UPLOAD_DIR=./uploads
# ChromaDB persistence (only if using Local VD / CHROMA_DB_PATH)
CHROMA_DB_PATH=./chroma_data

# --- Optional: RAG / Vector DB ---
# Embedding model for RAG and Local VD
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# If using Pinecone for RAG
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-documents
PINECONE_ENVIRONMENT=

# --- Optional: Chatbot (OpenAI) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Vector DB for chatbot context: pinecone | local
CHATBOT_VECTOR_DB=pinecone
CHATBOT_ENABLED=true
CHATBOT_TITLE=Assistant
CHATBOT_CUSTOM_INSTRUCTIONS=
# RAG
ENABLE_RAG=true
RAG_TIMEOUT_SECONDS=5.0

# --- Optional: Voice (Whisper / TTS) ---
WHISPER_MODEL_SIZE=base

# --- Optional: Scripts (migrations) ---
DATABASE_NAME=iso27001_compliance
